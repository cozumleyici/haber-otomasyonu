# ==============================================================================
# NEWS ENGINE INFRASTRUCTURE ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=news_user
POSTGRES_PASSWORD=secure_postgres_password_change_me
POSTGRES_DB=news_engine
POSTGRES_PORT=5432

# n8n Orchestrator Configuration
# If testing without SSL on VPS, set WEBHOOK_URL to http://<YOUR_VPS_IP>:5678/
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
WEBHOOK_URL=http://your_vps_ip_or_domain:5678/
GENERIC_TIMEZONE=Europe/Istanbul
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_min_32_chars

# AI Processing API Configuration (OpenAI or Gemini)
# Option 1: OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Option 2: Google Gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# Publishing Destination: Telegram Bot API
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# Publishing Destination: WordPress REST API
# Use an Application Password generated in WP Admin -> Users -> Profile -> Application Passwords
WORDPRESS_BASE_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=admin_editor
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Notification Webhook / Push Service (Optional alert when new drafts arrive)
ALERT_WEBHOOK_URL=http://your_vps_ip_or_domain:5678/webhook/alert-new-draft
