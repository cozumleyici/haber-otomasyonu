{
  "name": "Workflow C - Fetch Pending News Drafts API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "news-pending",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-pending",
      "name": "Webhook GET /news-pending",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "news-pending-webhook-id"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, source_type, source_url, original_title, original_content, ai_title, ai_content, image_url, status, target_platforms, created_at, updated_at FROM news_drafts WHERE status = 'PENDING' ORDER BY created_at DESC;"
      },
      "id": "node-query-pending",
      "name": "Query Pending from Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [440, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-cred-id",
          "name": "Postgres News DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\nreturn [{\n  json: {\n    success: true,\n    count: items.length,\n    data: items\n  }\n}];"
      },
      "id": "node-format-json",
      "name": "Format JSON Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "node-respond-pending",
      "name": "Respond with Drafts",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 300]
    }
  ],
  "connections": {
    "Webhook GET /news-pending": {
      "main": [
        [
          {
            "node": "Query Pending from Postgres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Pending from Postgres": {
      "main": [
        [
          {
            "node": "Format JSON Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format JSON Response": {
      "main": [
        [
          {
            "node": "Respond with Drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
